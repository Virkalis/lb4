<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox alignment="TOP_CENTER" spacing="15.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="example.demo.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="ИГРОВОЙ АВТОМАТ - МЕШОЧКИ" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #8B4513;"/>

    <HBox spacing="20" alignment="CENTER">
        <Label text="Монет:" style="-fx-font-size: 16px;"/>
        <Label fx:id="balanceLabel" text="0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: green;"/>
        <Button text="Добавить монету" onAction="#onPay"
                style="-fx-background-color: #FFD700; -fx-font-weight: bold;"/>
    </HBox>

    <ImageView fx:id="coinImage" fitWidth="100" fitHeight="100"
               style="-fx-border-color: #FFD700; -fx-border-width: 2px; -fx-border-radius: 50%;"/>

    <Label text="Выбери мешочек:" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>

    <HBox spacing="30" alignment="CENTER">
        <Button fx:id="bag1" text="Мешочек 1" onAction="#onBag1Click"
                style="-fx-font-size: 16px; -fx-padding: 25px; -fx-background-color: #DEB887; -fx-min-width: 120px; -fx-font-weight: bold;"/>
        <Button fx:id="bag2" text="Мешочек 2" onAction="#onBag2Click"
                style="-fx-font-size: 16px; -fx-padding: 25px; -fx-background-color: #DEB887; -fx-min-width: 120px; -fx-font-weight: bold;"/>
        <Button fx:id="bag3" text="Мешочек 3" onAction="#onBag3Click"
                style="-fx-font-size: 16px; -fx-padding: 25px; -fx-background-color: #DEB887; -fx-min-width: 120px; -fx-font-weight: bold;"/>
    </HBox>

    <Button fx:id="startButton" text="Кинуть монетку" onAction="#onStart"
            style="-fx-font-size: 14px; -fx-padding: 10px; -fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-min-width: 150px;"/>

    <Label fx:id="infoLabel" text="Нажми 'Кинуть монетку' чтобы начать"
           style="-fx-text-fill: #555; -fx-font-size: 12px;" wrapText="true" alignment="CENTER"/>

</VBox>